# ─────────────────────────────────────────────────────────────────────────────
# SNS — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DO NOT commit your real .env file — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Database
# SQLite for dev (file-based). For production, use PostgreSQL:
#   DATABASE_URL=postgresql://user:pass@host:5432/sns?schema=public
DATABASE_URL=file:./db/custom.db

# NextAuth
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32_OUTPUT
# In production, set this to your domain, e.g. https://sns.example.com
NEXTAUTH_URL=http://localhost:3090

# Server port — single-port architecture (Next.js + Socket.io share this port)
PORT=3090

# ─────────────────────────────────────────────────────────────────────────────
# WebRTC ICE servers — TURN provider configuration
# ─────────────────────────────────────────────────────────────────────────────
# Google STUN — always on, free, no auth
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# Metered Private TURN — OPTIONAL but recommended (uses YOUR quota, not shared)
# Get these from https://www.metered.ca/dashboard/ → Turn Server
# If left blank, the app falls back to Metered's free public OpenRelay (20 GB/month shared)
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=

# Cloudflare TURN — OPTIONAL. Leave blank to skip.
# To enable:
#   1. Cloudflare Dashboard → Realtime / Calls → Create TURN App
#   2. Copy Key ID and Secret (keep secret server-side only)
#   3. Fill in below. Server auto-generates time-limited REST API credentials per call.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_SECRET=
CLOUDFLARE_TURN_URL=turn:turn.cloudflare.com:3478?transport=udp

# Custom coturn — OPTIONAL. For self-hosted TURN.
# CUSTOM_TURN_URL=turn:my-coturn.example.com:3478
# CUSTOM_TURN_USER=myuser
# CUSTOM_TURN_CRED=mypassword

# Bot framework
BOT_WEBHOOK_BASE_URL=http://localhost:3090/api/bots/webhook

# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
