{
  "id": "/",
  "name": "Adoo",
  "short_name": "Adoo",
  "description": "A private social space for you and your friends.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#1a1b26",
  "theme_color": "#5865F2",
  "orientation": "portrait-primary",
  "categories": ["social", "communication"],
  "lang": "en",
  "dir": "auto",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Chats",
      "short_name": "Chats",
      "url": "/?view=chats&source=shortcut"
    },
    {
      "name": "Calls",
      "short_name": "Calls",
      "url": "/?view=voice&source=shortcut"
    },
    {
      "name": "Status",
      "short_name": "Status",
      "url": "/?view=status&source=shortcut"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 400
  }
}
